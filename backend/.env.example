# Development only. For production, set a long random SECRET_KEY and DEBUG=False.
SECRET_KEY=change-me
DEBUG=True
# Add deployment hostnames here when DEBUG=False.
ALLOWED_HOSTS=127.0.0.1,localhost
# Frontend origins allowed to call the API. Use HTTPS origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
API_PAGE_SIZE=12

# PostgreSQL connection used by Django locally.
# DB_HOST=localhost is for running Django on the host machine.
DB_ENGINE=postgresql
DB_NAME=store
DB_USER=postgres
DB_PASSWORD=8747
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL container variables used by docker-compose.yml.
POSTGRES_DB=store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=8747

# Use Redis-backed Channels in Docker/production. Local DEBUG=True runs can
# omit this and fall back to the in-memory channel layer.
CHANNEL_LAYER_REDIS_URL=

CACHE_TTL_PUBLIC_LISTS=120
PRODUCT_VIEW_COOLDOWN_MINUTES=30
GOOGLE_CLIENT_ID=643646366352-5v0vhunemhmuhopriilo0oulnst2v26i.apps.googleusercontent.com
FRONTEND_BASE_URL=http://localhost:3000
